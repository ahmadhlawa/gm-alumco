# T.A.S backend configuration.
# Copy to .env and fill in real values. Do NOT commit a real .env (it is gitignored).

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# The app refuses to start without a strong, unique secret.
# Minimum 16 characters enforced; >= 32 characters strongly recommended.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ── Optional (sensible local defaults exist) ─────────────────────────────────
APP_NAME=T.A.S API
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/gm_alomco_db
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Quote-request email notifications (STARTTLS; port 587 by default).
# In development, incomplete configuration logs a warning and skips delivery.
# In production, incomplete configuration logs an error; quote saving still succeeds.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=T.A.S
QUOTE_REQUEST_RECIPIENT_EMAIL=

# First super admin seeded by `python -m app.utils.seed_admin`.
# REQUIRED outside development: when ENVIRONMENT is not one of
# development/dev/local/test/testing, the app refuses to start with a
# default/placeholder/weak password. Minimum 12 characters enforced;
# >= 16 strongly recommended. In development a relaxed default is tolerated.
FIRST_SUPERADMIN_NAME=Super Admin
FIRST_SUPERADMIN_EMAIL=admin@gm-alomco.local
FIRST_SUPERADMIN_PASSWORD=
