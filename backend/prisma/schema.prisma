generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum QuoteStatus {
  NEW
  REVIEWED
  QUOTED
  REJECTED
  ARCHIVED
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Project {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            Json
  category         Json
  location         Json
  year             String
  shortDescription Json?
  description      Json?
  mainImage        String?
  featured         Boolean        @default(false)
  status           ContentStatus  @default(DRAFT)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ProjectImage[]

  @@index([status, sortOrder])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  alt       Json?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            Json
  shortDescription Json
  description      Json
  image            String?
  benefits         Json?
  applications     Json?
  status           ContentStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       Json
  category    Json
  description Json
  image       String?
  gallery     Json?
  features    Json?
  specs       Json?
  suitableFor Json?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model GalleryImage {
  id        String        @id @default(cuid())
  url       String
  alt       Json
  category  Json
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Partner {
  id        String        @id @default(cuid())
  name      Json
  logo      String?
  website   String?
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Testimonial {
  id        String        @id @default(cuid())
  name      Json
  role      Json
  company   Json?
  content   Json
  rating    Int           @default(5)
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  projectType String?
  message     String
  status      MessageStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

model QuoteRequest {
  id              String      @id @default(cuid())
  fullName        String
  phone           String
  email           String
  projectType     String
  serviceType     String
  location        String
  approximateArea String?
  notes           String?
  attachmentUrl   String?
  status          QuoteStatus @default(NEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
}

model SiteContent {
  id        String        @id @default(cuid())
  key       String        @unique
  content   Json
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}
